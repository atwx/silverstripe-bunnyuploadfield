{
    "name": "atwx/silverstripe-bunnyuploadfield",
    "description": "SilverStripe module for Bunny Upload Field video uploads with direct upload support",
    "type": "silverstripe-vendormodule",
    "keywords": [
        "silverstripe",
        "bunny",
        "video",
        "stream",
        "upload"
    ],
    "license": "BSD-3-Clause",
    "require": {
        "silverstripe/framework": "^6.1",
        "silverstripe/admin": "^3.0",
        "atwx/silverstripe-cms-popup": "^1"
    },
    "autoload": {
        "psr-4": {
            "Atwx\\BunnyUploadField\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Atwx\\BunnyUploadField\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^11"
    },
    "extra": {
        "expose": [
            "client/dist"
        ]
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "silverstripe/vendor-plugin": true
        }
    }
}
